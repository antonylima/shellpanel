# ========================================================
# ShellPanel - Configurações de Ambiente & Supabase Auth
# ========================================================

# Porta e Host do Servidor HTTP / WebSocket
PORT=3000
HOST=0.0.0.0

# --------------------------------------------------------
# Configurações do Supabase (Authentication)
# Obtenha estas informações em: https://supabase.com/dashboard
# Acesse o seu projeto -> Project Settings -> API
# --------------------------------------------------------

# URL do seu projeto no Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Chave pública anon do Supabase (Project API keys -> anon public)
SUPABASE_ANON_KEY=
